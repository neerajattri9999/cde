					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-31.westindia.logic.azure.com:443/workflows/a9a7490e90b74474a44eb86fc04f2754/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=snnNxfF9RC_mmeMXj9W3KLoTl8x9NjMLioG_1awuXW0",
					"connectVia": {
						"referenceName": "AutoResolveIntegrationRuntime",
